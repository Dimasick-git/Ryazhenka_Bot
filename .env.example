# ─────────────────────────────────────────────────────────
# Ryazhenka Bot — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────

# ─── Required ─────────────────────────────────────────
# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# ─── Admin Settings ────────────────────────────────────
# Comma-separated list of Telegram user IDs with admin access
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# ─── YouTube Integration ───────────────────────────────
# Comma-separated list of YouTube channel URLs, handles or UC IDs
# Example: YT_CHANNELS=https://www.youtube.com/@Chipovshchik,UCxxxxxx
YT_CHANNELS=https://www.youtube.com/@Chipovshchik

# Maximum number of videos to keep per channel
YT_KEEP_LIMIT=50

# Remove videos from guides when they disappear from the feed (1=yes, 0=no)
YT_PRUNE_REMOVED=1

# ─── GitHub Integration ────────────────────────────────
# GitHub repo to track releases (format: owner/repo)
# Example: GITHUB_REPO=Dimasick-git/Ryazhenka_Bot
GITHUB_REPO=

# Optional GitHub personal access token for higher API rate limits
GITHUB_TOKEN=

# ─── ⏱ Sync Settings ─────────────────────────────────────
# Background sync interval in seconds (default: 3600 = 1 hour)
SYNC_INTERVAL_SECONDS=3600

# ─── Web Server ────────────────────────────────────────
# Port for health-check HTTP server (Railway sets this automatically)
PORT=8080

# ─── ML Mode (optional) ────────────────────────────────
# Set to 1 to enable sentence-transformers semantic search
# Requires: pip install sentence-transformers
ML_MODE=0

# ─── Logging ───────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
